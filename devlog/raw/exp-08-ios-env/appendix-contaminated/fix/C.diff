+++ src/AppModel.swift	2026-10-08 10:57:04
@@ -33,3 +33,29 @@
 func epochDate(_ ms: Int64) -> String {
     Date(timeIntervalSince1970: TimeInterval(ms) / 1000).formatted(date: .abbreviated, time: .shortened)
 }
+
+/// 錯誤與警示文字的顏色。系統的 .red / .orange 在淺色底上對比不到 4.5:1(橘色約 2:1),
+/// 淺色模式改用深一階的紅/橘;深色模式沿用系統色,在黑底與深灰列底上都過 4.5:1。
+enum Tone { case error, warning }
+
+private struct ToneStyle: ViewModifier {
+    let tone: Tone
+    @Environment(\.colorScheme) private var scheme
+
+    func body(content: Content) -> some View {
+        content.foregroundStyle(color)
+    }
+
+    private var color: Color {
+        switch (tone, scheme) {
+        case (.error, .dark): Color(red: 1, green: 0.27, blue: 0.23)
+        case (.error, _): Color(red: 0.75, green: 0, blue: 0)
+        case (.warning, .dark): Color(red: 1, green: 0.62, blue: 0.04)
+        case (.warning, _): Color(red: 0.6, green: 0.3, blue: 0)
+        }
+    }
+}
+
+extension View {
+    func tone(_ tone: Tone) -> some View { modifier(ToneStyle(tone: tone)) }
+}
